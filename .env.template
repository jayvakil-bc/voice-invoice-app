# ==========================================
# BASIC CONFIGURATION (REQUIRED)
# ==========================================

# Server Configuration
PORT=3000
NODE_ENV=development
CLIENT_URL=http://localhost:3000
APP_URL=http://localhost:3000

# MongoDB Connection
# Replace with your actual MongoDB connection string
MONGODB_URI=mongodb://localhost:27017/invoice-app

# Session Secret
# Generate a random string for security
SESSION_SECRET=my-super-secret-random-key-change-this

# Google OAuth
# Get from: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=your-google-client-id-here
GOOGLE_CLIENT_SECRET=your-google-client-secret-here
GOOGLE_CALLBACK_URL=http://localhost:3000/auth/google/callback

# OpenAI API Key
# Get from: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-openai-api-key-here


# ==========================================
# TIER 1 FEATURES (OPTIONAL)
# ==========================================
# Leave these commented out if not using yet
# The app will work fine without them!

# Email Configuration (For sending invoices/contracts via email)
# Uncomment and configure to enable email features
#SMTP_HOST=smtp.gmail.com
#SMTP_PORT=587
#SMTP_SECURE=false
#SMTP_USER=your_email@gmail.com
#SMTP_PASSWORD=your_gmail_app_password_here
#SMTP_FROM_NAME=Invoice System

# Stripe Payment Links (For accepting payments)
# Uncomment and configure to enable payment features
#STRIPE_SECRET_KEY=sk_test_your_stripe_test_key_here

# Currency Conversion API (Optional - works without this)
# Uncomment to use enhanced currency rates
#EXCHANGE_RATE_API_KEY=your_api_key_here


# ==========================================
# NOTES
# ==========================================
# 
# BASIC FEATURES WORK WITHOUT:
# - Email (SMTP)
# - Payments (Stripe)  
# - Currency API (uses free fallback)
#
# You can add these later when you need them!
# See TESTING_GUIDE.md for setup instructions.
