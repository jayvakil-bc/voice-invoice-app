## ========== CONSOLIDATED BACKEND CONFIGURATION ==========

## Server Configuration
PORT=3000
NODE_ENV=development
CLIENT_URL=http://localhost:3000
APP_URL=http://localhost:3000

## MongoDB
MONGODB_URI=mongodb://localhost:27017/invoice-app

## Google OAuth
GOOGLE_CLIENT_ID=replace-with-google-client-id
GOOGLE_CLIENT_SECRET=replace-with-google-client-secret
GOOGLE_CALLBACK_URL=http://localhost:3000/auth/google/callback

## OpenAI
OPENAI_API_KEY=sk-your-openai-api-key-here

## Session (use a long random string)
SESSION_SECRET=replace-with-random-session-secret


## ========== TIER 1 FEATURES (NEW) ==========

## Email Configuration (for sending invoices/contracts)
## OPTION A - Gmail (easiest for testing):
##   1. Enable 2FA: https://myaccount.google.com/security
##   2. Create App Password: https://myaccount.google.com/apppasswords
##   3. Use the 16-character password below
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_16_char_app_password_here
EMAIL_FROM=your_email@gmail.com
EMAIL_FROM_NAME=Your Business Name

## OPTION B - SendGrid (best for production):
##   1. Sign up: https://signup.sendgrid.com (free 100/day)
##   2. Create API key: https://app.sendgrid.com/settings/api_keys
##   3. Verify sender: https://app.sendgrid.com/settings/sender_auth
# SMTP_HOST=smtp.sendgrid.net
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=apikey
# SMTP_PASS=SG.your_sendgrid_api_key_here
# EMAIL_FROM=verified@yourdomain.com
# EMAIL_FROM_NAME=Your Business Name

## Stripe Connect (Each user connects THEIR OWN Stripe account)
## THIS IS YOUR PLATFORM KEY - users will connect their own accounts
## Get from: https://dashboard.stripe.com/test/apikeys
## Enable Connect: https://dashboard.stripe.com/settings/connect
STRIPE_SECRET_KEY=sk_test_your_platform_secret_key_here
## For production: sk_live_your_platform_live_key_here

## Currency Conversion API (optional - free tier available)
## Get a free API key from https://www.exchangerate-api.com/
## Without this key, the app will use the free endpoint (limited to 1500 requests/month)
EXCHANGE_RATE_API_KEY=your_exchange_rate_api_key


## ========== SETUP INSTRUCTIONS ==========

## 📧 EMAIL SETUP:
##    See detailed guide: vibe-coder-bs/STRIPE_EMAIL_SETUP.md
##    Quick start (Gmail):
##    1. Enable 2FA: https://myaccount.google.com/security
##    2. Create App Password: https://myaccount.google.com/apppasswords
##    3. Paste 16-char password in SMTP_PASS above

## 💳 STRIPE CONNECT SETUP:
##    See detailed guide: vibe-coder-bs/STRIPE_EMAIL_SETUP.md
##    Quick start:
##    1. Sign up: https://stripe.com
##    2. Enable Connect: https://dashboard.stripe.com/settings/connect
##    3. Get platform key: https://dashboard.stripe.com/test/apikeys
##    4. Paste in STRIPE_SECRET_KEY above
##    5. Users will connect THEIR accounts via Settings page

## 💱 CURRENCY API (Optional):
##    - Sign up at https://www.exchangerate-api.com/
##    - Get your free API key (1500 requests/month)
##    - If not provided, uses open.er-api.com (also free)

## 🔄 RECURRING INVOICES:
##    - No configuration needed
##    - Cron job runs daily at 2:00 AM automatically

