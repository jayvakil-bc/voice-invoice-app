## ========== CONSOLIDATED BACKEND CONFIGURATION ==========

## Server Configuration
PORT=3000
NODE_ENV=development
CLIENT_URL=http://localhost:3000
APP_URL=http://localhost:3000

## MongoDB
MONGODB_URI=mongodb://localhost:27017/invoice-app

## Google OAuth
GOOGLE_CLIENT_ID=replace-with-google-client-id
GOOGLE_CLIENT_SECRET=replace-with-google-client-secret
GOOGLE_CALLBACK_URL=http://localhost:3000/auth/google/callback

## OpenAI
OPENAI_API_KEY=sk-your-openai-api-key-here

## Session (use a long random string)
SESSION_SECRET=replace-with-random-session-secret


## ========== TIER 1 FEATURES (NEW) ==========

## Email Configuration (for sending invoices/contracts)
## Use Gmail SMTP or any other SMTP provider
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_specific_password
SMTP_FROM_NAME=Invoice System

## Stripe Payment Links (for accepting payments)
## Get your keys from https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
## For production use: sk_live_your_stripe_live_key

## Currency Conversion API (optional - free tier available)
## Get a free API key from https://www.exchangerate-api.com/
## Without this key, the app will use the free endpoint (limited to 1500 requests/month)
EXCHANGE_RATE_API_KEY=your_exchange_rate_api_key


## ========== SETUP INSTRUCTIONS ==========

## 1. EMAIL SETUP (Gmail):
##    - Enable 2-factor authentication on your Gmail account
##    - Generate an app-specific password: https://myaccount.google.com/apppasswords
##    - Use that password in SMTP_PASSWORD

## 2. STRIPE SETUP:
##    - Sign up at https://stripe.com
##    - Get your test API key from https://dashboard.stripe.com/test/apikeys
##    - For production, switch to live keys and update STRIPE_SECRET_KEY

## 3. CURRENCY API (Optional):
##    - Sign up at https://www.exchangerate-api.com/
##    - Get your free API key (1500 requests/month)
##    - If not provided, the app uses open.er-api.com (also free, also limited)

## 4. RECURRING INVOICES:
##    - No configuration needed - runs automatically via cron job
##    - Cron job runs daily at 2:00 AM to generate recurring invoices

